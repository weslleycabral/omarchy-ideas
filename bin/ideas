#!/usr/bin/env python3
"""Capture ideas; an AI agent fixes the spelling and writes a title.

  ideas                 open the new-idea box
  ideas list            open the list of ideas
  ideas add <text>      save an idea (the AI fixes it in the background)
  ideas rm <id>         delete an idea
  ideas process <id>    (re)run the AI on an idea
  ideas lang [code]     show or set the language (en, pt, es, fr)
  ideas json            print every idea
"""

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from contextlib import contextmanager

PLUGIN = "weslleycabral.ideas"
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "omarchy-ideas")
DB = os.path.join(DATA_DIR, "ideas.json")
LOCK = os.path.join(DATA_DIR, ".lock")
SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omarchy-ideas", "settings.json")
LANGS = ("en", "pt", "es", "fr")
AI_TIMEOUT = 120

PROMPT = """You receive an idea someone jotted down in a hurry.
1. Fix spelling, accents, punctuation and typos without changing the meaning or adding content. Keep technical terms and proper names.
2. Write a short title (at most 8 words) that sums up the idea.
Keep both in the same language the idea is written in; never translate.
Reply ONLY with a JSON object, no markdown: {"title": "...", "text": "..."}

Idea:
<<<
%s
>>>"""

MESSAGES = {
    "en": ("Idea saved without correction", "No AI agent answered."),
    "pt": ("Ideia salva sem correção", "Nenhum agente de IA respondeu."),
    "es": ("Idea guardada sin corrección", "Ningún agente de IA respondió."),
    "fr": ("Idée enregistrée sans correction", "Aucun agent IA n'a répondu."),
}


def read_settings():
    try:
        with open(SETTINGS) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def lang():
    code = read_settings().get("lang") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    code = code[:2].lower()
    return code if code in LANGS else "en"


@contextmanager
def locked():
    os.makedirs(DATA_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        ideas = load()
        yield ideas
        fd, tmp = tempfile.mkstemp(dir=DATA_DIR, suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            json.dump(ideas, f, ensure_ascii=False, indent=2)
        os.replace(tmp, DB)


def load():
    try:
        with open(DB) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def fallback_title(text):
    first = text.strip().splitlines()[0]
    return first if len(first) <= 60 else first[:57].rstrip() + "…"


def summon(mode):
    subprocess.run(["omarchy-shell", "shell", "summon", PLUGIN, json.dumps({"mode": mode})])


def notify(title, body=""):
    subprocess.run(["notify-send", "-a", "Ideas", title, body], check=False)


def agents(prompt, workdir):
    """AI CLIs found on PATH, in order of preference."""
    out = os.path.join(workdir, "codex-out.txt")
    candidates = [
        ("claude", ["claude", "-p", "--model", "haiku", "--setting-sources", "",
                    "--strict-mcp-config", "--tools", "", "--no-session-persistence", prompt], None),
        ("codex", ["codex", "exec", "--skip-git-repo-check", "--ephemeral", "-s", "read-only",
                   "-o", out, prompt], out),
        ("gemini", ["gemini", "-p", prompt], None),
        ("opencode", ["opencode", "run", prompt], None),
    ]
    return [(name, cmd, out_file) for name, cmd, out_file in candidates if shutil.which(cmd[0])]


def parse(output):
    match = re.search(r"\{.*\}", output, re.S)
    if not match:
        return None
    try:
        data = json.loads(match.group(0))
    except json.JSONDecodeError:
        return None
    title, text = str(data.get("title", "")).strip(), str(data.get("text", "")).strip()
    return (title, text) if title and text else None


def ask_ai(raw):
    with tempfile.TemporaryDirectory() as workdir:
        for name, cmd, out_file in agents(PROMPT % raw, workdir):
            try:
                proc = subprocess.run(cmd, cwd=workdir, capture_output=True, text=True,
                                      timeout=AI_TIMEOUT, stdin=subprocess.DEVNULL)
            except subprocess.TimeoutExpired:
                continue
            output = proc.stdout
            if out_file and os.path.exists(out_file):
                output = open(out_file).read()
            result = parse(output)
            if result:
                return name, *result
    return None


def cmd_add(text):
    text = text.strip()
    if not text:
        sys.exit("empty idea")
    idea = {
        "id": uuid.uuid4().hex[:8],
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "title": fallback_title(text),
        "text": text,
        "original": text,
        "status": "processing",
    }
    with locked() as ideas:
        ideas.append(idea)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "process", idea["id"]],
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(idea["id"])


def cmd_process(idea_id):
    idea = next((i for i in load() if i["id"] == idea_id), None)
    if not idea:
        sys.exit("idea not found")
    result = ask_ai(idea["original"])
    with locked() as ideas:
        for i in ideas:
            if i["id"] == idea_id:
                if result:
                    i["agent"], i["title"], i["text"] = result
                    i["status"] = "ok"
                else:
                    i["status"] = "no-ai"
    if not result:
        notify(*MESSAGES[lang()])


def cmd_rm(idea_id):
    with locked() as ideas:
        ideas[:] = [i for i in ideas if i["id"] != idea_id]


def cmd_lang(code):
    if code is None:
        print(lang())
        return
    if code not in LANGS:
        sys.exit("languages: " + ", ".join(LANGS))
    settings = read_settings()
    settings["lang"] = code
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS, "w") as f:
        json.dump(settings, f, indent=2)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "new"
    if cmd in ("new", "nova", "nueva", "nouvelle"):
        summon("new")
    elif cmd in ("list", "lista", "liste"):
        summon("list")
    elif cmd == "add":
        cmd_add(" ".join(args[1:]) if len(args) > 1 else sys.stdin.read())
    elif cmd == "rm" and len(args) == 2:
        cmd_rm(args[1])
    elif cmd == "process" and len(args) == 2:
        cmd_process(args[1])
    elif cmd == "lang" and len(args) <= 2:
        cmd_lang(args[1] if len(args) == 2 else None)
    elif cmd == "json":
        print(json.dumps(load(), ensure_ascii=False, indent=2))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
